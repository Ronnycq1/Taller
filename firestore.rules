rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS (Layer 4 - Security & Least Privilege)
    // =========================================================================

    // Identity check: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Is the user accessing their own user document?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role helper from custom claims or user token
    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() == "Administrador" ||
        getUserRole() == "admin" ||
        request.auth.token.admin == true
      );
    }

    function isManager() {
      return isAuthenticated() && (
        getUserRole() == "Gerente de Operaciones" ||
        getUserRole() == "Gerencia" ||
        isAdmin()
      );
    }

    function isMechanic() {
      return isAuthenticated() && (
        getUserRole() == "Mecánico" ||
        getUserRole() == "mecanico" ||
        isManager()
      );
    }

    // Validates document ID length & safe characters to mitigate Path Injection & Denial of Wallet
    function isValidDocId(docId) {
      return docId.size() > 0 && docId.size() <= 128 && docId.matches('^[a-zA-Z0-9_-]+$');
    }

    // Validates non-negative numerical values
    function isNonNegative(val) {
      return val is number && val >= 0;
    }

    // Validates field immutability on update
    function isFieldUnchanged(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }

    // =========================================================================
    // COLLECTION: /vehicles
    // Threat Vector Protections: Payload 1 (Plate Hijack), Payload 2 (Massive ID), Payload 11 (Phone Spoofing), Payload 12 (Path Injection)
    // =========================================================================
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && isValidDocId(vehicleId)
        && request.resource.data.placa is string
        && request.resource.data.placa.size() >= 3
        && request.resource.data.placa.size() <= 10
        && isNonNegative(request.resource.data.kilometraje);

      allow update: if isAuthenticated()
        // Payload 1: Vehicle Plate & ID Immutability
        && isFieldUnchanged("placa")
        && isFieldUnchanged("id")
        && isFieldUnchanged("fechaIngreso")
        && isNonNegative(request.resource.data.kilometraje);

      allow delete: if isAdmin();
    }

    // =========================================================================
    // COLLECTION: /appointments (Citas)
    // Threat Vector Protections: Payload 3 (Spoofed Timestamp), Payload 5 (Unauthenticated Leak), Payload 7 (Terminal State Lock)
    // =========================================================================
    match /appointments/{appointmentId} {
      // Payload 5: Unauthenticated List & Read Leak Prevention
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && isValidDocId(appointmentId)
        && request.resource.data.nombreCliente is string
        && request.resource.data.nombreCliente.size() <= 100
        && request.resource.data.correoCliente is string
        && request.resource.data.telefonoCliente is string
        && isNonNegative(request.resource.data.kilometraje);

      allow update: if isAuthenticated()
        // Payload 7: Terminal State Locking (Completada / Cancelada cannot be mutated except by Admins)
        && (
          !(resource.data.estado in ["Completada", "Cancelada"])
          || isAdmin()
        )
        && isFieldUnchanged("id");

      allow delete: if isAdmin();
    }

    // =========================================================================
    // COLLECTION: /maintenances (Mantenimientos)
    // Threat Vector Protections: Payload 4 (Orphan Maintenance), Payload 6 (Negative Cost Poisoning)
    // =========================================================================
    match /maintenances/{maintenanceId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && isValidDocId(maintenanceId)
        // Payload 4: Relational Integrity Guard (Vehicle must exist in /vehicles)
        && exists(/databases/$(database)/documents/vehicles/$(request.resource.data.vehiculoId))
        // Payload 6: Negative Cost Poisoning Prevention
        && isNonNegative(request.resource.data.costoManoObra)
        && isNonNegative(request.resource.data.totalCalculado);

      allow update: if isAuthenticated()
        && isFieldUnchanged("vehiculoId")
        && isFieldUnchanged("id")
        // Payload 6: Negative Cost Prevention on Update
        && isNonNegative(request.resource.data.costoManoObra)
        && isNonNegative(request.resource.data.totalCalculado);

      allow delete: if isAdmin();
    }

    // =========================================================================
    // COLLECTION: /inventory (Inventario)
    // Threat Vector Protections: Payload 9 (Shadow Field Injection), Payload 10 (Anonymous Admin Write)
    // =========================================================================
    match /inventory/{inventoryId} {
      allow read: if isAuthenticated();

      // Payload 10: Anonymous Administrative Access Prevention
      allow create, update: if (isAdmin() || isManager())
        && isValidDocId(inventoryId)
        && isNonNegative(request.resource.data.stock)
        && isNonNegative(request.resource.data.precioVenta)
        && isNonNegative(request.resource.data.costoCompra)
        // Payload 9: Strict Allowed Keys Inspection (Prevent Shadow Fields)
        && request.resource.data.keys().hasOnly([
          'id', 'codigo', 'nombre', 'stock', 'stockMinimo',
          'precioVenta', 'costoCompra', 'ubicacion', 'categoria', 'imagenUrl'
        ]);

      allow delete: if isAdmin();
    }

    // =========================================================================
    // COLLECTION: /activities (Logs de Auditoría)
    // Threat Vector Protections: Payload 8 (Audit Log Deletion / Tampering)
    // =========================================================================
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && isValidDocId(activityId);

      // Logs are immutable audit trails
      allow update: if false;
      
      // Payload 8: Direct Activity Log Tampering Prevention
      allow delete: if false;
    }

    // =========================================================================
    // COLLECTION: /users (Usuarios del Sistema & Perfiles)
    // Privilege Isolation & Role Assignment Guard
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && isOwner(userId)
        // Self-assignment of admin role is forbidden
        && (request.resource.data.role != "Administrador" || isAdmin());

      allow update: if isOwner(userId)
        // Role cannot be self-escalated
        && isFieldUnchanged("role")
        || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    // COLLECTIONS: /surveys, /loyalty, /rewards, /redemptions
    // =========================================================================
    match /surveys/{surveyId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /loyalty/{loyaltyId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isManager() || isAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isManager() || isAdmin();
    }

    match /redemptions/{redemptionId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isManager() || isAdmin();
    }
  }
}

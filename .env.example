# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SQL SERVER CONFIGURATION (For backend integration)
SQL_SERVER=your-database-server.database.windows.net
SQL_DATABASE=your_database_name
SQL_USER=your_db_username
SQL_PASSWORD=your_db_password
SQL_PORT=1433
SQL_ENCRYPT=true

# WHATSAPP BUSINESS API CONFIGURATION
# Permanent ACCESS TOKEN from Meta's developer console
WHATSAPP_ACCESS_TOKEN=
# Phone Number ID (ID de número de teléfono del panel WhatsApp Cloud)
WHATSAPP_PHONE_NUMBER_ID=
# Optional Template name (nombre de plantilla aprobada por Meta, opcional)
WHATSAPP_TEMPLATE_NAME=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SQL SERVER CONFIGURATION (For backend integration)
SQL_SERVER=your-database-server.database.windows.net
SQL_DATABASE=your_database_name
SQL_USER=your_db_username
SQL_PASSWORD=your_db_password
SQL_PORT=1433
SQL_ENCRYPT=true

# =============================================================
# STAFF AUTHENTICATION (FIX CRÍTICO-1: Credentials only on server)
# =============================================================
# OPTION A: JSON array with all staff accounts
# STAFF_ACCOUNTS=[{"user":"ronnycq","pass":"YOUR_STRONG_PASSWORD","role":"Administrador","name":"Eco. Ronny Cadena"},{"user":"washo03","pass":"YOUR_STRONG_PASSWORD","role":"Mecanico","name":"Ing. Washington Cadena"}]
STAFF_ACCOUNTS=

# OPTION B: Individual env vars per staff member (alternative to STAFF_ACCOUNTS)
# STAFF_USER_1=ronnycq
# STAFF_PASS_1=YOUR_STRONG_PASSWORD_HERE
# STAFF_ROLE_1=Administrador
# STAFF_NAME_1=Eco. Ronny Cadena
#
# STAFF_USER_2=washo03
# STAFF_PASS_2=YOUR_STRONG_PASSWORD_HERE
# STAFF_ROLE_2=Mecanico
# STAFF_NAME_2=Ing. Washington Cadena

# =============================================================
# WHATSAPP BUSINESS API CONFIGURATION
# =============================================================
# Permanent ACCESS TOKEN from Meta's developer console
WHATSAPP_ACCESS_TOKEN=
# Phone Number ID (ID de número de teléfono del panel WhatsApp Cloud)
WHATSAPP_PHONE_NUMBER_ID=
# Optional Template name (nombre de plantilla aprobada por Meta, opcional)
WHATSAPP_TEMPLATE_NAME=
# Webhook Verify Token — set a long random secret (DO NOT use a fallback default)
# Generate with: openssl rand -hex 32
WHATSAPP_VERIFY_TOKEN=
# App Secret from Meta Developer Console — required for HMAC webhook signature validation (FIX M4)
WHATSAPP_APP_SECRET=

